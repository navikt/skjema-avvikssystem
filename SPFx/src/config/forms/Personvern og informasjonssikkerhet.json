{
    "$schema": "./schema/schema.json",
    "title": "Information security",
    "conditionalOptions": {
        "Violation of personal data security": [
            "Letter sent to the wrong recipient",
            "Letter sent to the wrong employer",
            "Information accompanies letter sent to another recipient",
            "E-mail or SMS sent to the wrong recipient",
            "Information registered on the wrong user",
            "Documents are scanned and registered on the wrong user",
            "Error in an IT system",
            "Deviations committed by the data processor",
            "Loss of equipment, phone, computer",
            "Overhearing conversations with confidential personal information",
            "Lookup without official need",
            "Personal information is lost or not available",
            "Personal information has been unrightly edited",
            "Other"
        ],
        "Violation of privacy requirements": [
            "Basis for processing",
            "The rights of the registered",
            "Data management agreements",
            "Transfer to third countries",
            "Storage/deletion",
            "Processing documentation, compliance, privacy impact assessment, risk and vulnerability analysis",
            "Usage of pictures, sound- and videorecording",
            "Monitoring/control of employees",
            "Birth number/biometric identifiers",
            "Other unwanted incidents"
        ]
    },
    "description": {
        "type": "html",
        "categories": {
            "page": 4,
            "field": "category"
        },
        "contentTemplate": "<div style='padding: 5px 10px'> <h3 style='margin-left: 15px'>Kategorier</h3> <ul> {categories} </ul> </div>"
    },
    "pages": [
        {
            "key": 0,
            "type": "Validation",
            "renderConditions": [
                {
                    "condition": "false",
                    "message": "",
                    "type": "error"
                }
            ]
        },
        {
            "key": 1,
            "type": "Input",
            "fields": [
                {
                    "key": "anonymous",
                    "label": "Anonym innmelding",
                    "type": "Checkbox",
                    "defaultValue": "false",
                    "description": "Obs! Ved anonym innmelding vil du ikke få tilsendt saksnummer og ikke ha mulighet til innsyn i avviket.",
                    "infoText": "Ved anonym innmelding vil det ikke bli knyttet noen opplysninger om deg til avviksmeldingen. Det vil ikke være mulig for saksbehandler å etterspørre mer informasjon, og det er derfor viktig at informasjonen som fylles inn er så utfyllende som mulig. Når du velger å være anonym, må du i feltet \"Velg enhet\" velge den Nav-enheten som du vil skal motta og følge opp avviksmeldingen."
                },
                {
                    "key": "unit",
                    "label": "Hvilken enhet gjelder avviket?",
                    "type": "ChoiceGroup",
                    "options": [
                        "Min enhet",
                        "Annen enhet"
                    ],
                    "required": "true",
                    "defaultValue": "Min enhet",
                    "showInSummary": "false",
                    "dynamicValue": {
                        "variable": "state.values.anonymous",
                        "condition": "{variable} === true",
                        "value": "Annen enhet"
                    },
                    "disabled": "state.values.anonymous === true",
                    "additionalData": [
                        {
                            "key": "Min enhet",
                            "value": "context.unit",
                            "fallback": "Min enhet"
                        }
                    ],
                    "optionOverrides": [
                        {
                            "option": "Min enhet",
                            "stateVariable": "selectedMunicipality",
                            "value": "context.municipalityOrgNumber"
                        },
                        {
                            "option": "Annen enhet",
                            "stateVariable": "selectedMunicipality",
                            "value": null
                        }
                    ]
                },
                {
                    "key": "unitOther",
                    "label": "Velg enhet",
                    "type": "Choice",
                    "searchable": true,
                    "options": "context.orgUnits",
                    "optionType": {
                        "type": "object",
                        "key": "id",
                        "text": "name"
                    },
                    "hidden": "!(state.values.unit === 'Annen enhet')",
                    "required": "state.values.unit === 'Annen enhet'",
                    "optionOverrides": [
                        {
                            "option": "*",
                            "stateVariable": "selectedMunicipality",
                            "value": "context.agreementOptions.filter(o => o.unit === option.data.unit).length === 1 ? context.agreementOptions.filter(o => o.unit === option.data.unit)[0].key : state.values.selectedMunicipality"
                        }
                    ]
                }
            ],
            "actions": [
                {
                    "key": "previous",
                    "label": "Tilbake",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronLeft"
                    },
                    "invoke": {
                        "functionName": "ToFormSelection"
                    }
                },
                {
                    "key": "next",
                    "label": "Neste",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronRight"
                    },
                    "iconPosition": "right",
                    "disabled": "!state.valid",
                    "invoke": {
                        "functionName": "NextPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    }
                }
            ]
        },
        {
            "key": 2,
            "title": "Gjelder det en statlig eller kommunal tjeneste?",
            "type": "Input",
            "fields": [
                {
                    "key": "stateOrMunicipalityService",
                    "type": "ChoiceGroup",
                    "options": [
                        "State",
                        "Municipal",
                        "Unsure"
                    ],
                    "required": "true",
                    "choiceInfoTexts": [
                        {
                            "key": "State",
                            "text": "Omfatter statlige arbeids- og velferdstjenester som arbeid, trygd, familie, pensjon, tiltak og hjelpemidler mfl."
                        },
                        {
                            "key": "Municipal",
                            "text": "Omfatter sosiale tjenester og andre kommunale tjenester i NAV-kontoret"
                        }
                    ]
                },
                {
                    "key": "selectedMunicipality",
                    "label": "Avviket knyttes til følgende:",
                    "type": "Choice",
                    "options": "state.values.unit !== 'Annen enhet' ? context.agreementOptions.filter(o => o.unit === context.unitNumber) : context.agreementOptions.filter(o => o.unit === state.otherUnitNumber)",
                    "optionType": {
                        "type": "object",
                        "key": "key",
                        "text": "text"
                    },
                    "required": "state.values.stateOrMunicipalityService === 'Municipal' && context.agreementOptions.length > 0",
                    "hidden": "(context.unitIsKontaktsenter && state.values.unit !== 'Annet enhet' && state.values.stateOrMunicipalityService === 'Municipal') || (state.values.unit === 'Annen enhet' && state.values.stateOrMunicipalityService === 'Municipal' && context.agreementOptions.filter(o => o.unit === state.otherUnitNumber)[0]?.data.kontaktsenter) || !(state.values.stateOrMunicipalityService === 'Municipal') || (state.values.stateOrMunicipalityService === 'Municipal' && state.values.unit !== 'Annen enhet' && !context.unitDataAgreement) || (state.values.stateOrMunicipalityService === 'Municipal' && state.values.unit === 'Annen enhet' && state.values.unitOther && !state.agreement)",
                    "infoText": "Vennligst velg en kommune fra listen."
                }
            ],
            "messages": [
                {
                    "display": "(context.unitIsKontaktsenter && state.values.unit !== 'Annet enhet' && state.values.stateOrMunicipalityService === 'Municipal') || (state.values.unit === 'Annen enhet' && state.values.stateOrMunicipalityService === 'Municipal' && context.agreementOptions.filter(o => o.unit === state.otherUnitNumber)[0]?.data.kontaktsenter)",
                    "type": "error",
                    "content": "Det kan ikke registreres personvern- eller informasjonssikkerhetsavvik som gjelder kommunale tjenester på et kontaktsenter.",
                    "position": "bottom"
                },
                {
                    "display": "state.values.stateOrMunicipalityService === 'Municipal' && state.values.unit !== 'Annen enhet' && !context.unitDataAgreement",
                    "type": "error",
                    "content": "Fordi Nav-kontoret du jobber ved ikke har inngått databehandleravtale med Nav kan du ikke rapportere avviket her. Inntil videre skal denne type avvik rapporteres i kommunens eget avvikssystem.",
                    "position": "bottom"
                },
                {
                    "display": "state.values.stateOrMunicipalityService === 'Municipal' && state.values.unit === 'Annen enhet' && state.values.unitOther && !state.agreement",
                    "type": "error",
                    "content": "Fordi dette Nav-kontoret ikke har inngått databehandleravtale med Nav, kan du ikke rapportere avviket her. Inntil videre skal denne type avvik rapporteres i kommunens eget avvikssystem.",
                    "position": "bottom"
                }
            ],
            "actions": [
                {
                    "key": "previous",
                    "label": "Tilbake",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronLeft"
                    },
                    "invoke": {
                        "functionName": "PreviousPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    }
                },
                {
                    "key": "next",
                    "label": "Neste",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronRight"
                    },
                    "iconPosition": "right",
                    "disabled": "(context.unitIsKontaktsenter && state.values.unit !== 'Annet enhet' && state.values.stateOrMunicipalityService === 'Municipal') || (state.values.unit === 'Annen enhet' && state.values.stateOrMunicipalityService === 'Municipal' && context.agreementOptions.filter(o => o.unit === state.otherUnitNumber)[0]?.data.kontaktsenter) || !state.values.stateOrMunicipalityService || (state.values.stateOrMunicipalityService === 'Municipal' && state.values.unit === 'Annen enhet' && !state.agreement) || (state.values.stateOrMunicipalityService === 'Municipal' && state.values.unit === 'Annen enhet' && state.agreement && context.agreementOptions.filter(o => o.unit === state.otherUnitNumber).length > 1 && !state.values.selectedMunicipality) || (state.values.stateOrMunicipalityService === 'Municipal' && state.values.unit !== 'Annen enhet' && !context.unitDataAgreement) || !state.valid",
                    "invoke": {
                        "functionName": "NextPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    }
                }
            ]
        },
        {
            "key": 3,
            "title": "Har personopplysninger blitt utilsiktet eller ulovlig:",
            "type": "Input",
            "fields": [
                {
                    "key": "personalDataBreach",
                    "label": "",
                    "type": "ChoiceGroup",
                    "options": [
                        "Ja",
                        "Nei"
                    ],
                    "required": "true",
                    "description": "• slettet\n• tapt\n• endret\n• delt (herunder ulovlig tilgang til personopplysninger)?"
                }
            ],
            "messages": [
                {
                    "display": "true",
                    "type": "info",
                    "content": "Eksempel kan være at Nav har sendt brev som inneholder navn og fødselsnummer til feil mottaker.",
                    "position": "bottom"
                }
            ],
            "actions": [
                {
                    "key": "previous",
                    "label": "Tilbake",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronLeft"
                    },
                    "invoke": {
                        "functionName": "PreviousPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    }
                },
                {
                    "key": "next",
                    "label": "Neste",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronRight"
                    },
                    "iconPosition": "right",
                    "disabled": "!state.valid",
                    "invoke": {
                        "functionName": "NavigateFromBreachQuestion",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    }
                }
            ]
        },
        {
            "key": 4,
            "title": "Velg kategori",
            "type": "Input",
            "fields": [
                {
                    "key": "category",
                    "type": "ChoiceGroup",
                    "options": [
                        "Violation of personal data security",
                        "Violation of privacy requirements",
                        "Violation of policies",
                        "Other unwanted incidents"
                    ],
                    "choiceInfoTexts": [
                        {
                            "key": "Violation of personal data security",
                            "text": "Ett brudd på personopplysningssikkerhet er at personopplysningene er på avveie, er blitt endret eller slettet, eller ikke tilgjengelig. Eksempler kan være brev sendt til feil mottaker, opplysninger registrert på feil bruker, eller feil i ett IT-system."
                        },
                        {
                            "key": "Violation of privacy requirements",
                            "text": "Brudd på lovkrav etter personvernregelverket."
                        }
                    ],
                    "required": "true"
                }
            ],
            "actions": [
                {
                    "key": "previous",
                    "label": "Tilbake",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronLeft"
                    },
                    "invoke": {
                        "functionName": "PreviousPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    }
                },
                {
                    "key": "next",
                    "label": "Neste",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronRight"
                    },
                    "iconPosition": "right",
                    "disabled": "!state.valid",
                    "invoke": {
                        "functionName": "NextPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    },
                    "addtobreadcrumbs": "state.values.category"
                }
            ]
        },
        {
            "key": 5,
            "title": "Velg underkategori",
            "type": "Input",
            "fields": [
                {
                    "key": "categoryDetails",
                    "type": "ChoiceGroup",
                    "options": "form.conditionalOptions[state.values.category]",
                    "required": "form.conditionalOptions[state.values.category]",
                    "hidden": "!(form.conditionalOptions[state.values.category])",
                    "choiceInfoTexts": [
                        {
                            "key": "Error in an IT system",
                            "text": "Feil som medfører at personopplysninger blir synlige for personer som ikke skal se de. Andre feil kan være at personopplysningene er blitt uriktig endret, slettet, eller vært utilgjengelige."
                        },
                        {
                            "key": "Basis for processing",
                            "text": "Brudd knyttet til at all bruk av personopplysninger skal ha et behandlingsgrunnlag for å være lovlig."
                        },
                        {
                            "key": "The rights of the registered",
                            "text": "Brudd knyttet til at NAV ikke ivaretar rettigheter den registrerte har, eller ikke har behandlet krav fra den registrerte innen gjeldende frister. Registrertes rettigheter omfatter rett til informasjon, innsyn i egne personopplysninger, rett til sletting eller endring av personopplysninger, rett til begrensning, dataportabilitet og retten til å protestere."
                        },
                        {
                            "key": "Transfer to third countries",
                            "text": "Brudd knyttet til overføring av personopplysninger til tredjeland (land utenfor EU/EØS som ikke er forhåndsgodkjent av EU-kommisjonen)"
                        },
                        {
                            "key": "Storage/deletion",
                            "text": "Brudd knyttet til at lagringstid ikke er fastsatt eller at personopplysninger lagres lengre enn fastsatt lagringstid."
                        },
                        {
                            "key": "Processing documentation, compliance, privacy impact assessment, risk and vulnerability analysis",
                            "text": "Brudd på krav til dokumentasjon, eks. personvernkonsekvensvurdering, etterlevelseskrav og behandlingskatalog"
                        },
                        {
                            "key": "Birth number/biometric identifiers",
                            "text": "Ulovlig eller unødvendig bruk av fødselsnummer eller andre biometriske kjennetegn som fingeravtrykk, ansikt- og stemmegjenkjenning, DNA o.l."
                        },
                        {
                            "key": "Other unwanted incidents",
                            "text": "Andre personvernbrudd som ikke er kategorisert her eller som faller inn under mer enn en kategori."
                        },
                        {
                            "key": "Data management agreements",
                            "text": "Brudd knyttet til at databehandleravtale mangler, ikke er gyldig, at databehandler behandler personopplysninger utover avtalens instrukser mm."
                        }
                    ]
                }
            ],
            "actions": [
                {
                    "key": "previous",
                    "label": "Tilbake",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronLeft"
                    },
                    "invoke": {
                        "functionName": "PreviousPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    },
                    "removefrombreadcrumbs": "true"
                },
                {
                    "key": "next",
                    "label": "Neste",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronRight"
                    },
                    "iconPosition": "right",
                    "disabled": "!state.values.categoryDetails",
                    "invoke": {
                        "functionName": "NextPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    },
                    "addtobreadcrumbs": "state.values.categoryDetails"
                }
            ]
        },
        {
            "key": 6,
            "type": "Input",
            "fields": [
                {
                    "key": "criticalityCriteria",
                    "label": "Kritikalitetskriteria",
                    "type": "Choice",
                    "multiselect": true,
                    "options": [
                        "User with protected address is involved",
                        "Personal information is publicly available",
                        "Loss of unencrypted equipment",
                        "Lookup without official need",
                        "Medical certificate is lost/involved in incident",
                        "Number of affected people is more than five",
                        "None of these"
                    ],
                    "optionType": {
                        "type": "string"
                    },
                    "required": "state.values.category === 'Violation of personal data security'",
                    "hidden": "state.values.category !== 'Violation of personal data security'"
                },
                {
                    "key": "timeOfIncident",
                    "label": "Når skjedde avviket?",
                    "type": "Date",
                    "required": "true"
                },
                {
                    "key": "timeOfDiscovery",
                    "label": "Når ble avviket oppdaget?",
                    "type": "DateTime",
                    "required": "state.values.category !== 'Violation of privacy requirements'"
                },
                {
                    "key": "isExternalReporter",
                    "label": "Ble avviket oppdaget av noen utenfor NAV?",
                    "type": "ChoiceGroup",
                    "options": [
                        "Yes",
                        "No"
                    ],
                    "required": "state.values.category === 'Violation of personal data security'",
                    "hidden": "state.values.category !== 'Violation of personal data security' && state.values.category !== 'Violation of privacy requirements'"
                },
                {
                    "key": "externalReporter",
                    "label": "Oppgi navn og telefonnummer på ekstern innmelder",
                    "type": "Text",
                    "maxLength": 255,
                    "placeholder": "Ola Normann, 47101112",
                    "multiline": true,
                    "hidden": "!(state.values.isExternalReporter === 'Yes') || state.values.category !== 'Violation of personal data security'",
                    "required": "state.values.isExternalReporter === 'Yes' && state.values.category === 'Violation of personal data security'"
                },
                {
                    "key": "affectedPeopleCount",
                    "label": "Antall berørte:",
                    "type": "Number",
                    "valid": "state.values.affectedPeopleCount >= 0",
                    "errorMessage": "Antall berørte kan ikke være et negativt tall",
                    "hidden": "state.values.category !== 'Violation of personal data security' && state.values.category !== 'Violation of privacy requirements'",
                    "required": "state.values.category === 'Violation of personal data security'"
                },
                {
                    "key": "affectedPeople",
                    "label": "Hvem er de berørte?",
                    "type": "Text",
                    "maxLength": 1000,
                    "multiline": true,
                    "placeholder": "Oppgi navn og personnummer, ett per linje",
                    "hidden": "state.values.category !== 'Violation of personal data security'",
                    "required": "state.values.category === 'Violation of personal data security'"
                },
                {
                    "key": "informationType",
                    "label": "Hvilken type personopplysninger er berørt?",
                    "type": "Text",
                    "maxLength": 255,
                    "multiline": true,
                    "hidden": "state.values.category !== 'Violation of personal data security' && state.values.category !== 'Violation of privacy requirements'",
                    "required": "state.values.category === 'Violation of personal data security'"
                },
                {
                    "key": "incidentDescription",
                    "label": "Hva har skjedd?",
                    "type": "Text",
                    "maxLength": 3000,
                    "placeholder": "Beskriv avviket, mulig årsak og eventuelle konsekvenser",
                    "multiline": true,
                    "required": "true"
                },
                {
                    "key": "imediateMeasuresDescription",
                    "label": "Beskriv eventuelle iverksatte strakstiltak:",
                    "type": "Text",
                    "maxLength": 3000,
                    "multiline": true
                },
                {
                    "key": "measureSuggestionsDescription",
                    "label": "Har du forslag til tiltak for å unngå at noe slikt skjer igjen?",
                    "type": "Text",
                    "maxLength": 3000,
                    "multiline": true,
                    "required": "true"
                }
            ],
            "actions": [
                {
                    "key": "previous",
                    "label": "Tilbake",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronLeft"
                    },
                    "invoke": {
                        "functionName": "PreviousPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    },
                    "removefrombreadcrumbs": "true"
                },
                {
                    "key": "next",
                    "label": "Neste",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronRight"
                    },
                    "iconPosition": "right",
                    "disabled": "!state.valid",
                    "invoke": {
                        "functionName": "NextPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    }
                }
            ]
        },
        {
            "key": 7,
            "title": "Verifiser opplysningene som er registrert",
            "type": "Summary",
            "values": "state.values",
            "actions": [
                {
                    "key": "previous",
                    "label": "Tilbake",
                    "type": "default",
                    "iconProps": {
                        "iconName": "ChevronLeft"
                    },
                    "invoke": {
                        "functionName": "PreviousPage",
                        "params": {
                            "state_pageNumber": "currentPageNumber",
                            "setstate": "currentPageNumber"
                        }
                    }
                },
                {
                    "key": "submit",
                    "label": "Send inn",
                    "type": "primary",
                    "disabled": "!state.summaryConfirmed",
                    "invoke": {
                        "functionName": "Submit",
                        "params": {
                            "state_values": "values",
                            "context_functionUrl": "functionUrl",
                            "context_environment": "environment",
                            "setstate": "submitting",
                            "resultVariable": "submitResult"
                        }
                    }
                }
            ]
        }
    ]
}